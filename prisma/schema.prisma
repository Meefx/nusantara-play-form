// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// === SURVEY MODEL ===
model Survey {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("draft") // "draft" | "completed"
  section1    Section1
  section2    Section2
  section3    Section3
  section4    Section4
  section5    Section5
  section6    Section6

  @@index([submittedAt])
  @@index([status])
}

// === SECTION 1 TYPES ===
type KontakResponden {
  namaLengkap String @default("")
  nomorHP     String @default("")
  email       String @default("")
  provinsi    String @default("")
  kabKota     String @default("")
}

type Section1 {
  kategoriResponden String           @default("")
  kontakResponden   KontakResponden
  jumlahPROT        String           @default("")
  jumlahPROTOther   String           @default("")
}

// === SECTION 2 TYPES ===
type LokasiPROT {
  provinsi      String @default("")
  kabKota       String @default("")
  kecamatan     String @default("")
  desa          String @default("")
  alamatLengkap String @default("")
}

type KontakKoordinator {
  nama  String @default("")
  hp    String @default("")
  email String @default("")
}

type KontakPelatih {
  nama  String @default("")
  hp    String @default("")
  email String @default("")
}

type Entry {
  entryNumber    Int
  namaPROT       String          @default("")
  jenisKategori  String          @default("")
  statusAsalUsul String          @default("")
  lokasi         LokasiPROT
  koordinator    KontakKoordinator
  pelatih        KontakPelatih
  peralatanPROT  String          @default("")
  caraBermain    String          @default("")
  nilaiMoral     String          @default("")
}

type Section2 {
  entries Entry[]
}

// === SECTION 3 TYPES ===
type Section3 {
  frekuensiDimainkan      String @default("")
  frekuensiOther          String @default("")
  targetUsia              String @default("")
  jumlahPenggiat          String @default("")
  ketersediaanLahan       String @default("")
  ketersediaanLahanOther  String @default("")
  partisipasiSekolah      String @default("")
  partisipasiSekolahOther String @default("")
  penghargaanJuara        String @default("")
  penghargaanJuaraOther   String @default("")
}

// === SECTION 4 TYPES ===
type Section4 {
  produksiAlat          String @default("")
  hargaAlat             String @default("")
  dayaTarikWisata       String @default("")
  kerjasamaUMKM         String @default("")
  penyerapanTenagaKerja String @default("")
}

// === SECTION 5 TYPES ===
type Section5 {
  hambatanUtama           String[] @default([])
  hambatanUtamaOther      String   @default("")
  kebutuhanMendesak       String[] @default([])
  kebutuhanMendesakOther  String   @default("")
  harapanKPOTI            String   @default("")
}

// === SECTION 6 TYPES ===
type Section6 {
  fotoAlat     String[] @default([])
  fotoKegiatan String[] @default([])
  videoPROT    String[] @default([])
}
