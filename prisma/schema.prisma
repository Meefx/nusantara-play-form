// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// === SURVEY MODEL ===
model Survey {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("draft") // "draft" | "completed"
  section1    Section1
  section2    Section2

  @@index([submittedAt])
  @@index([status])
}

// === SECTION 1 TYPES ===
type WilayahKerja {
  provinsi      String @default("")
  kabKota       String @default("")
  kecamatan     String @default("")
  desaKelurahan String @default("")
}

type Kontak {
  namaLengkap String @default("")
  nomorHP     String @default("")
  instansi    String @default("")
}

type Section1 {
  role            String      @default("")
  roleOther       String      @default("")
  wilayahKerja    WilayahKerja
  kontak          Kontak
  jumlahPROT      String      @default("")
  jumlahPROTOther String      @default("")
}

// === SECTION 2 TYPES ===
type Lokasi {
  jenis            String[] @default([])
  lokasiOther      String   @default("")
  kelengkapanLokasi String  @default("")
  alamatLengkap    String   @default("")
  koordinatGPS     String   @default("")
}

type Identitas {
  kategori   String @default("")
  namaPROT   String @default("")
  adaNamaLain String @default("")
  variasiNama String @default("")
  lokasi     Lokasi
}

type Aturan {
  statusAturan       String   @default("")
  sumberRujukan      String[] @default([])
  sumberRujukanOther String   @default("")
  ringkasanAturan    String   @default("")
  adaVariasiAturan   String   @default("")
  jelaskanVariasi    String   @default("")
}

type Koordinator {
  ada       String @default("")
  peran     String @default("")
  peranOther String @default("")
  cakupan   String @default("")
  kontak    String @default("")
}

type Pelatih {
  status        String @default("")
  level         String @default("")
  kontak        String @default("")
  jadwalLatihan String @default("")
}

type Pakar {
  ada           String   @default("")
  kategori      String[] @default([])
  kategoriOther String   @default("")
  kontak        String   @default("")
  adaBukti      String   @default("")
}

type SDM {
  koordinator Koordinator
  pelatih     Pelatih
  pakar       Pakar
}

type KomunitasAktivitas {
  adaKomunitas         String   @default("")
  bentukKomunitas      String[] @default([])
  bentukKomunitasOther String   @default("")
  statusKeaktifan      String   @default("")
  frekuensiKegiatan    String   @default("")
  jenisKegiatan        String[] @default([])
  jenisKegiatanOther   String   @default("")
  adaDokumentasi       String   @default("")
}

type AlatProduksi {
  adaPengrajin      String   @default("")
  skalaProduksi     String   @default("")
  kepemilikanAlat   String[] @default([])
  kondisiAlat       String   @default("")
  standardisasiAlat String   @default("")
  dokumentasiAlat   String[] @default([])
}

type PeranPemda {
  adaPeran            String   @default("")
  bentukPeran         String[] @default([])
  bentukPeranOther    String   @default("")
  bentukDukungan      String[] @default([])
  bentukDukunganOther String   @default("")
  buktiDukungan       String[] @default([])
}

type KondisiKepengurusan {
  perkembangan              String   @default("")
  indikatorPerkembangan     String[] @default([])
  indikatorPerkembanganOther String  @default("")
  kegiatanBerjalan          String[] @default([])
  kegiatanBerjalanOther     String   @default("")
  statusProgram             String   @default("")
  kendala                   String[] @default([])
  kendalaOther              String   @default("")
  dampakKendala             String   @default("")
  catatanTambahan           String   @default("")
}

type Entry {
  entryNumber         Int
  identitas           Identitas
  aturan              Aturan
  sdm                 SDM
  komunitasAktivitas  KomunitasAktivitas
  alatProduksi        AlatProduksi
  peranPemda          PeranPemda
  kondisiKepengurusan KondisiKepengurusan
}

type Section2 {
  entries Entry[]
}
